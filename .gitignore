# -----------------------------------------------------------------------
# TupiTube Server - .gitignore
# -----------------------------------------------------------------------

*.so
*.0
*.1
*.moc
*.qm
*.pri
*.user
*qrc_resources.cpp
*.stash
.vscode

# Build output: deployed runtime DLLs and the application binary
bin/

# Build logs
build_output.txt

# Compiled static libraries (all release/ and debug/ dirs under src/)
src/**/release/
src/**/debug/

# qmake-generated object scripts (contain absolute paths, regenerated on every qmake run)
**/object_script.*

# qmake-generated Windows resource file (auto-created from RC_ICONS in shell.pro)
src/shell/tupitube.server_resource.rc

# qmake-generated Makefiles (regenerated by configure.ps1 / qmake)
**/Makefile
**/Makefile.Debug
**/Makefile.Release

# Compiled object files
**/*.o
**/*.obj

# Compiled libraries
**/*.a
**/*.lib

# Installer output (generated .exe)
installer/output/

tests/tests
